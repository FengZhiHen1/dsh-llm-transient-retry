{
  "name": "dsh-llm-transient-retry",
  "version": "0.1.0",
  "description": "DSH 插件：按文本限定识别上游瞬态失败（过载类报文），以标准 llm/retry 事件做可见的自动重试，避免升级为 turn 级失败。",
  "type": "module",
  "main": "./src/adapter/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FengZhiHen1/dsh-llm-transient-retry.git"
  },
  "exports": {
    ".": "./src/adapter/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "files": [
    "src/",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "layering": "node ../../tools/plugin-layering-check.mjs .",
    "test": "node --test test/*.test.mjs",
    "check": "node ../../tools/plugin-layering-check.mjs . && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm-retry": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
